[Unit]
Description=Trace osqueryd file access via bpftrace
BindsTo=orbit.service
After=orbit.service

[Service]
Type=simple
# Wait for osqueryd and capture its pid atomically, then exec bpftrace on it.
# Doing the lookup and the exec in the same shell avoids the race where the
# pid disappears between a separate pre-check and start (which would launch
# bpftrace with no tgid argument and make it exit immediately).
ExecStart=/bin/sh -c 'for i in $(seq 30); do pid=$(pgrep -x osqueryd | tail -1); [ -n "$pid" ] && exec /usr/bin/bpftrace /etc/prometheus/file-trace.bt "$pid"; sleep 1; done; echo "osqueryd not running after 30s" >&2; exit 1'
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/osquery-trace.log
StandardError=journal
SyslogIdentifier=osquery-trace

[Install]
WantedBy=multi-user.target
