{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "All Processes - Power",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "topk(10, scalar(rate(node_rapl_energy_joules[1m])) * clamp_min(deriv(node_process_cpu_seconds_total[1m]), 0) / scalar(sum(clamp_min(deriv(node_process_cpu_seconds_total[1m]), 0))))",
          "legendFormat": "{{comm}}",
          "refId": "A"
        },
        {
          "expr": "scalar(rate(node_rapl_energy_joules[1m])) * (sum(clamp_min(deriv(node_process_cpu_seconds_total[1m]), 0)) - sum(topk(10, clamp_min(deriv(node_process_cpu_seconds_total[1m]), 0)))) / scalar(sum(clamp_min(deriv(node_process_cpu_seconds_total[1m]), 0)))",
          "legendFormat": "others",
          "refId": "B"
        },
        {
          "expr": "avg_over_time(rate(node_rapl_energy_joules[1m])[5m:])",
          "legendFormat": "avg (5m)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "spanNulls": true,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "avg (5m)" },
            "properties": [
              { "id": "custom.stacking", "value": { "mode": "none" } },
              { "id": "custom.lineWidth", "value": 2 },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 5] } },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "white" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "sortBy": "Max", "sortDesc": true }
      }
    },
